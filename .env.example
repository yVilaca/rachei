VITE_APP_NAME=Rachei
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ── Sentry (frontend) — vazio = desligado ────────────────────────────
# DSN do projeto React no Sentry (é seguro expor no cliente).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_SAMPLE_RATE=0.1
# VITE_SENTRY_RELEASE é setado pela CI/deploy (SHA do git).
VITE_SENTRY_RELEASE=

# ── Build-time (SOMENTE na CI, como secrets — NÃO expor no cliente) ───
# Usados pelo @sentry/vite-plugin para subir source maps. Não levam VITE_.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
